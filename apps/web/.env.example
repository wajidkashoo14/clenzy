# Copy this file to .env.local and fill in real values.
# Full variable reference: docs/ARCHITECTURE.md §6. Setup guides: docs/INTEGRATIONS.md.
# Only NEXT_PUBLIC_* variables belong here — anything secret goes in apps/api/.env instead.

NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only secret (never prefix with NEXT_PUBLIC_) verifying calls to
# /api/revalidate. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REVALIDATE_SECRET=

# Razorpay — optional. Unset means /checkout/processing shows a dev-only
# payment simulator instead of loading real Razorpay Checkout. See
# apps/api/.env.example and docs/INTEGRATIONS.md §2.2.
# NEXT_PUBLIC_RAZORPAY_KEY_ID=

# --- Added in later phases ---
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
# NEXT_PUBLIC_SENTRY_DSN=
