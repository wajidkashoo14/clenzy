# Copy this file to .env and fill in real values.
# Full variable reference: docs/ARCHITECTURE.md §6. Setup guides: docs/INTEGRATIONS.md.
# Never commit the real .env file.

NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (replica set required — see docs/INTEGRATIONS.md §2.1)
MONGODB_URI=mongodb+srv://clenzy_app:<password>@<cluster>.mongodb.net/clenzy_dev?retryWrites=true&w=majority

# Comma-separated list of origins allowed to call this API with credentials
CORS_ORIGINS=http://localhost:3000
COOKIE_DOMAIN=localhost
# The web app's own origin — used to build absolute links in emails/SMS.
WEB_APP_URL=http://localhost:3000

# JWT secrets — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Run it twice; access and refresh must use different secrets.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# MSG91 — optional. Unset uses a console-logging fake SMS adapter (OTPs print
# to the server log). See docs/INTEGRATIONS.md §2.3.
# MSG91_AUTH_KEY=
# MSG91_SENDER_ID=
# MSG91_OTP_TEMPLATE_ID=

# One DLT-registered template id per "SMS justified" notification event — see
# docs/PAYMENTS_AND_NOTIFICATIONS.md §3.2. Unset means that event's SMS is
# skipped (in-app/email still send); DLT approval is an external process, not
# a code dependency — see docs/DEVELOPMENT_PLAN.md Phase 10.
# MSG91_TEMPLATE_ORDER_PLACED=
# MSG91_TEMPLATE_PAYMENT_FAILED=
# MSG91_TEMPLATE_PICKUP_REMINDER=
# MSG91_TEMPLATE_PRICE_REVISION=
# MSG91_TEMPLATE_OUT_FOR_DELIVERY=
# MSG91_TEMPLATE_PICKUP_DELIVERY_FAILED=
# MSG91_TEMPLATE_ORDER_CANCELLED=
# MSG91_TEMPLATE_REFUND_COMPLETED=

# Resend — optional. Unset uses a console-logging fake email adapter (emails
# print to the server log). See docs/INTEGRATIONS.md §2.4.
# RESEND_API_KEY=
# EMAIL_FROM=Clenzy <orders@clenzy.in>

# Razorpay — optional. Unset uses a console-logging fake payment adapter and
# a dev-only payment simulator on /checkout/processing (KYC pending — see
# docs/INTEGRATIONS.md §2.2). RAZORPAY_WEBHOOK_SECRET has a dev default even
# when unset, so simulated webhooks are still signature-verified for real.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# --- Added in later phases (uncomment and fill in when that phase lands) ---
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# GOOGLE_MAPS_SERVER_KEY=
# SENTRY_DSN=
