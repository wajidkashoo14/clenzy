# Copy this file to .env and fill in real values.
# Full variable reference: docs/ARCHITECTURE.md §6. Setup guides: docs/INTEGRATIONS.md.
# Never commit the real .env file.

NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (replica set required — see docs/INTEGRATIONS.md §2.1)
MONGODB_URI=mongodb+srv://clenzy_app:<password>@<cluster>.mongodb.net/clenzy_dev?retryWrites=true&w=majority

# Comma-separated list of origins allowed to call this API with credentials
CORS_ORIGINS=http://localhost:3000
COOKIE_DOMAIN=localhost

# --- Added in later phases (uncomment and fill in when that phase lands) ---
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# MSG91_AUTH_KEY=
# MSG91_SENDER_ID=
# MSG91_OTP_TEMPLATE_ID=
# RESEND_API_KEY=
# EMAIL_FROM=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# GOOGLE_MAPS_SERVER_KEY=
# SENTRY_DSN=
